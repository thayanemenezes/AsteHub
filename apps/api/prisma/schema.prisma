generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id                       String              @id @default(cuid()) @db.VarChar(30)
  email                    String              @unique @db.VarChar(320)
  passwordHash             String              @db.VarChar(255)
  passwordResetRequestedAt DateTime?           @db.Timestamptz(3)
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(3)
  memberships              Membership[]
  sessions                 Session[]
  passwordResetToken       PasswordResetToken?
}

model Organization {
  id                String            @id @default(cuid()) @db.VarChar(30)
  name              String            @db.VarChar(120)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  memberships       Membership[]
  vehicles          Vehicle[]
  vehicleCategories VehicleCategory[]
  locations         Location[]
  site              Site?
  leads             Lead[]
}

model Vehicle {
  id             String       @id @default(cuid()) @db.VarChar(30)
  organizationId String       @db.VarChar(30)
  make           String       @db.VarChar(80)
  model          String       @db.VarChar(100)
  year           Int
  description    String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@index([organizationId, createdAt])
}

model VehicleCategory {
  id             String       @id @default(cuid()) @db.VarChar(30)
  organizationId String       @db.VarChar(30)
  name           String       @db.VarChar(80)
  description    String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model Location {
  id             String       @id @default(cuid()) @db.VarChar(30)
  organizationId String       @db.VarChar(30)
  name           String       @db.VarChar(120)
  address        String       @db.VarChar(250)
  city           String       @db.VarChar(100)
  state          String       @db.VarChar(100)
  phone          String?      @db.VarChar(40)
  description    String?      @db.VarChar(500)
  managerName    String?      @db.VarChar(120)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@index([organizationId, createdAt])
}

model Lead {
  id             String       @id @default(cuid()) @db.VarChar(30)
  organizationId String       @db.VarChar(30)
  contactName    String       @db.VarChar(120)
  email          String?      @db.VarChar(320)
  phone          String       @db.VarChar(15)
  message        String       @db.VarChar(1000)
  status         LeadStatus   @default(NEW)
  vehicleId      String?      @db.VarChar(30)
  locationId     String?      @db.VarChar(30)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
}

model Site {
  id             String       @id @default(cuid()) @db.VarChar(30)
  organizationId String       @unique @db.VarChar(30)
  publicName     String       @db.VarChar(120)
  slug           String       @unique @db.VarChar(60)
  domain         String?      @unique @db.VarChar(253)
  phone          String?      @db.VarChar(40)
  description    String?      @db.VarChar(1000)
  primaryColor   String?      @db.Char(7)
  secondaryColor String?      @db.Char(7)
  logoUrl        String?      @db.VarChar(2048)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Membership {
  id             String           @id @default(cuid()) @db.VarChar(30)
  userId         String           @db.VarChar(30)
  organizationId String           @db.VarChar(30)
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @unique @db.VarChar(30)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
