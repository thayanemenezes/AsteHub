{
  "name": "@astehub/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run build --workspace @astehub/api && vitest run --config vitest.integration.config.ts test/integration"
  },
  "dependencies": {
    "@repo/ui": "*",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.9.1",
    "jsdom": "^27.0.1",
    "typescript": "7.0.2",
    "vitest": "^4.0.18"
  }
}
